# ============================================================
# Hold-On Backend — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# --- Neon DB ------------------------------------------------
# Get from: https://console.neon.tech -> Connection string
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/neondb?ssl=require

# --- Gnani AI -----------------------------------------------
# STT (Prisma) + TTS (Timbre) — same API key
GNANI_API_KEY=your-gnani-api-key-here

# Prisma STT endpoints
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_REST_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=hi-IN,en-IN
GNANI_STT_SAMPLE_RATE=8000
GNANI_STT_FORMAT=codemix

# Timbre TTS endpoints
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_REST_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=hi-IN-default
GNANI_TTS_LANGUAGE=hi-en
GNANI_TTS_SPEED=1.0

# --- Sarvam-30B (self-hosted, OpenAI-compatible) -----------
# URL of your rented VM running Sarvam-30B via vLLM
SARVAM_BASE_URL=http://your-vm-ip:8000/v1
SARVAM_MODEL=sarvamai/sarvam-30b
SARVAM_API_KEY=EMPTY
# Fallback model if VM not available
SARVAM_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- App Configuration ------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo clock — seconds in real-time = 1 simulated day
DEMO_CLOCK_RATIO=86400

# Deadline worker poll interval (seconds)
DEADLINE_POLL_INTERVAL=5

# Family view token secret (random string)
FAMILY_TOKEN_SECRET=change-me-to-random-secret

# Embedding model (runs locally on CPU)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# Audio sample rate for the demo
AUDIO_SAMPLE_RATE=8000
