# ============================================================
# Mock-On — Root Git Ignore
# ============================================================

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
*.env
*.env.local
*.env.production
*.env.development
*.env.*
!.env.example
!backend/.env.example

# Local SQLite databases & cache
*.db
*.db-journal
*.sqlite
*.sqlite3
holdon.db
backend/holdon.db

# Dependencies
node_modules/
frontend/node_modules/
backend/venv/
backend/.venv/
venv/
.venv/
ENV/
env/

# Build artifacts
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
build/
*.egg-info/
.eggs/

# Python bytecode & cache
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
